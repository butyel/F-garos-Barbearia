---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTA from '../../components/CTA.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { articleSchema, breadcrumbs } from '../../lib/schema';
import { whatsappLink } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter((p) => !p.data.draft)
    .map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { data } = post;
const { Content } = await render(post);
const allPosts = await getCollection('blog');
const related = allPosts
  .filter((p) => !p.data.draft && p.id !== post.id)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const dateStr = (d: Date) => d.toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric' });
const isoDate = (d: Date) => d.toISOString();
const schema = [
  articleSchema({
    title: data.title,
    description: data.description,
    path: `/blog/${post.id}/`,
    image: data.image,
    publishedTime: isoDate(data.pubDate),
    modifiedTime: data.updatedDate ? isoDate(data.updatedDate) : undefined,
    author: data.author,
  }),
  breadcrumbs([
    { name: 'Início', path: '/' },
    { name: 'Blog', path: '/blog/' },
    { name: data.title, path: `/blog/${post.id}/` },
  ]),
];
---

<BaseLayout
  title={data.title}
  description={data.description}
  path={`/blog/${post.id}/`}
  ogType="article"
  publishedTime={isoDate(data.pubDate)}
  modifiedTime={data.updatedDate ? isoDate(data.updatedDate) : undefined}
  schema={schema}
>
  <article>
    <section class="page-hero">
      <div class="container-narrow">
        <Breadcrumb items={[{ name: 'Blog', path: '/blog/' }, { name: data.category, path: '/blog/' }]} />
        <div
          class="article-category"
          style="color:var(--gold);text-transform:uppercase;letter-spacing:1.5px;font-size:0.8rem;font-weight:600;margin-bottom:0.75rem;"
        >
          {data.category}
        </div>
        <h1 style="font-size:clamp(1.8rem,4vw,2.6rem);">{data.title}</h1>
        <div class="article-meta">
          <a href="/sobre/" class="article-author">{data.author}</a>
          <span>Atualizado em {dateStr(data.updatedDate ?? data.pubDate)}</span>
        </div>
      </div>
    </section>

    <section class="section section--black">
      <div class="container-narrow">
        {data.image && (
          <img
            src={data.image}
            alt={data.title}
            width="800"
            height="800"
            loading="eager"
            decoding="async"
            style="border-radius:10px;width:100%;margin-bottom:2rem;"
          />
        )}
        <div class="prose">
          <Content />
        </div>

        <div class="note" style="margin-top:2rem;">
          <strong>Ficou com uma dúvida sobre prótese capilar?</strong>{' '}
          Conheça como funciona a{' '}
          <a href="/protese-capilar-presidente-epitacio/">prótese capilar em Presidente Epitácio</a>, tire dúvidas
          no{' '}
          <a href={whatsappLink('blog')} target="_blank" rel="noopener noreferrer">WhatsApp</a> ou agende sua{' '}
          <a href="/contato/">avaliação gratuita</a>.
        </div>
      </div>
    </section>
  </article>

  {related.length > 0 && (
    <section class="section section--charcoal">
      <div class="container">
        <div class="section-header">
          <h2>Leia também</h2>
        </div>
        <div class="grid-3">
          {related.map((p) => (
            <ArticleCard
              title={p.data.title}
              slug={p.id}
              category={p.data.category}
              description={p.data.description}
              pubDate={p.data.pubDate}
              author={p.data.author}
              image={p.data.image}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <CTA
    title="Aprendeu algo novo?"
    description="Transforme o conhecimento em resultado: agende sua avaliação gratuita."
    whatsappKey="blog"
  />
</BaseLayout>