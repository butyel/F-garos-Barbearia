---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getCollection } from 'astro:content';
import { services } from '../../data/services';
import { SITE } from '../../data/site';

const posts = await getCollection('blog');
const publicPosts = posts.filter((p) => !p.data.draft);

const repoHref = 'https://github.com/butyel/F-garos-Barbearia';
const vercelHref = 'https://vercel.com';
---

<AdminLayout>
  <main class="admin-main" id="main">
    <header class="admin-topbar">
      <div>
        <h1 class="admin-title">Painel — {SITE.name}</h1>
        <p class="admin-subtitle">Site estático (Astro) • página administrativa</p>
      </div>
      <span class="admin-badge">v2.0.0</span>
    </header>

    <section class="admin-gate" data-panel="login">
      <div class="admin-login-box">
        <h2>Autenticação</h2>
        <p>Este painel é restrito. Digite a senha para liberar.</p>

        <form class="admin-form" data-admin-form>
          <label for="admin-password">Senha de acesso</label>
          <input
            id="admin-password"
            name="password"
            type="password"
            autocomplete="current-password"
            placeholder="••••••••"
            required
          />
          <p class="admin-form-error" data-form-error hidden>Acesso negado — tente novamente.</p>
          <button type="submit" class="admin-btn">Entrar</button>
        </form>

        <p class="admin-login-back"><a href="/">← Voltar ao site</a></p>
      </div>
    </section>

    <section class="admin-gate admin-dashboard" data-panel="dashboard" hidden>
      <div class="admin-stats">
        <div class="admin-stat">
          <span class="admin-stat-value">{publicPosts.length}</span>
          <span class="admin-stat-label">Artigos no blog</span>
        </div>
        <div class="admin-stat">
          <span class="admin-stat-value">{services.length}</span>
          <span class="admin-stat-label">Páginas de serviço</span>
        </div>
        <div class="admin-stat">
          <span class="admin-stat-value">{new Date().getFullYear()}</span>
          <span class="admin-stat-label">Ano em curso</span>
        </div>
      </div>

      <div class="admin-grid">
        <div class="admin-card">
          <h2>Artigos publicados</h2>
          <ul class="admin-list">
            {publicPosts.map((p) => (
              <li class="admin-li">
                <span class="admin-li-title">{p.data.title}</span>
                <span class="admin-li-route">/blog/{p.id}/</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="admin-card">
          <h2>Ações rápidas</h2>
          <ul class="admin-links">
            <li><a href={repoHref} target="_blank" rel="noopener noreferrer">Repositório GitHub →</a></li>
            <li><a href={vercelHref} target="_blank" rel="noopener noreferrer">Dashboard Vercel →</a></li>
            <li><a href="/blog/" target="_blank" rel="noopener noreferrer">Ver blog publicado →</a></li>
            <li><a href="/" target="_blank" rel="noopener noreferrer">Ver site →</a></li>
            <li><a href="/sitemap-index.xml" target="_blank" rel="noopener noreferrer">Sitemap →</a></li>
          </ul>
          <p class="admin-note">
            O conteúdo deste site é estático (Astro). Para editar, publique os arquivos em{" "}
            <code>src/content/blog/</code> e <code>src/data/</code>, depois faça deploy na Vercel.
          </p>
        </div>
      </div>

      <button type="button" class="admin-btn admin-btn--ghost" data-admin-logout>Sair</button>
    </section>
  </main>

  <style>
    :global(.admin-body) {
      background: var(--black);
      color: var(--white);
      font-family: var(--font-sans);
      min-height: 100vh;
    }
    .admin-main {
      max-width: 980px;
      margin: 0 auto;
      padding: 2.5rem 1.25rem 4rem;
    }
    .admin-topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 2rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--dark);
    }
    .admin-title {
      font-family: var(--font-serif);
      font-size: clamp(1.5rem, 3.5vw, 2rem);
      color: var(--white);
      margin: 0 0 0.25rem;
    }
    .admin-subtitle {
      font-size: 0.9rem;
      color: var(--gray);
      margin: 0;
    }
    .admin-badge {
      background: var(--gold);
      color: var(--black);
      font-weight: 700;
      font-size: 0.8rem;
      padding: 0.35rem 0.7rem;
      border-radius: 999px;
      text-transform: uppercase;
    }
    .admin-login-box {
      background: var(--charcoal);
      border: 1px solid var(--dark);
      border-radius: 12px;
      padding: 2rem;
      max-width: 420px;
      margin: 2rem auto 0;
    }
    .admin-login-box h2 {
      font-family: var(--font-serif);
      color: var(--gold);
      margin-top: 0;
    }
    .admin-form {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }
    .admin-form input {
      padding: 0.75rem 1rem;
      border-radius: 8px;
      border: 1px solid var(--dark);
      background: var(--black);
      color: var(--white);
      font-size: 1rem;
    }
    .admin-form input:focus {
      outline: 2px solid var(--gold);
      outline-offset: 2px;
    }
    .admin-form-error {
      color: #ff6b6b;
      margin: 0;
      font-size: 0.9rem;
    }
    .admin-btn {
      cursor: pointer;
      background: var(--gold);
      color: var(--black);
      border: none;
      border-radius: 8px;
      padding: 0.75rem 1.2rem;
      font-weight: 700;
      font-size: 1rem;
    }
    .admin-btn:hover {
      background: var(--gold-light);
    }
    .admin-btn--ghost {
      background: transparent;
      border: 1px solid var(--gold);
      color: var(--gold);
      margin-top: 2rem;
    }
    .admin-login-back {
      margin: 1rem 0 0;
      font-size: 0.9rem;
    }
    .admin-login-back a {
      color: var(--gold);
    }
    .admin-stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 1rem;
      margin-bottom: 2rem;
    }
    .admin-stat {
      background: var(--charcoal);
      border: 1px solid var(--dark);
      border-radius: 12px;
      padding: 1.25rem;
    }
    .admin-stat-value {
      display: block;
      font-family: var(--font-serif);
      font-size: 2.2rem;
      color: var(--gold);
    }
    .admin-stat-label {
      display: block;
      font-size: 0.85rem;
      color: var(--gray);
    }
    .admin-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }
    .admin-card {
      background: var(--charcoal);
      border: 1px solid var(--dark);
      border-radius: 12px;
      padding: 1.5rem;
    }
    .admin-card h2 {
      font-family: var(--font-serif);
      color: var(--gold);
      margin-top: 0;
      border-bottom: 1px solid var(--dark);
      padding-bottom: 0.5rem;
    }
    .admin-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }
    .admin-li {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
    .admin-li-title {
      color: var(--white);
    }
    .admin-li-route {
      font-size: 0.8rem;
      color: var(--gray);
      font-family: monospace;
    }
    .admin-links {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
    }
    .admin-links a {
      color: var(--white);
      text-decoration: none;
    }
    .admin-links a:hover {
      color: var(--gold);
    }
    .admin-note {
      font-size: 0.85rem;
      color: var(--gray);
      margin-top: 1rem;
    }
    code {
      background: var(--dark);
      padding: 0.15rem 0.4rem;
      border-radius: 4px;
      font-size: 0.85rem;
    }
    @media (max-width: 720px) {
      .admin-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <script>
    const PASSWORD = import.meta.env.PUBLIC_ADMIN_PASSWORD || 'figaros-admin';
    const SESSION_KEY = 'figaros_admin';
    const login = document.querySelector<HTMLElement>('[data-panel="login"]');
    const dashboard = document.querySelector<HTMLElement>('[data-panel="dashboard"]');
    const form = document.querySelector<HTMLFormElement>('[data-admin-form]');
    const errorEl = document.querySelector<HTMLElement>('[data-form-error]');

    function unlock() {
      if (login) login.hidden = true;
      if (dashboard) dashboard.hidden = false;
      sessionStorage.setItem(SESSION_KEY, '1');
    }

    if (sessionStorage.getItem(SESSION_KEY) === '1') unlock();

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const value = new FormData(form).get('password');
      if (value === PASSWORD) {
        if (errorEl) errorEl.hidden = true;
        unlock();
      } else if (errorEl) {
        errorEl.hidden = false;
      }
    });

    document.querySelector('[data-admin-logout]')?.addEventListener('click', () => {
      sessionStorage.removeItem(SESSION_KEY);
      if (dashboard) dashboard.hidden = true;
      if (login) login.hidden = false;
      form?.reset();
    });
  </script>
</AdminLayout>