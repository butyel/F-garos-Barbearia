# Figaro's Barbearia — variáveis de ambiente
# Copie este arquivo para `.env` e preencha os valores.

# --- SEO / Domínio ---
# URL canônica oficial. Quando definida (ex.: https://www.exemplo.com.br),
# canonical, Open Graph, sitemap e JSON-LD passam a usar esse domínio.
PUBLIC_SITE_URL=

# Controle de indexação: defina "true" APENAS quando o domínio oficial estiver
# em produção. Qualquer outro valor mantém o site inteiro com "noindex, nofollow"
# (evita a indexação do ambiente temporário *.vercel.app).
PUBLIC_ALLOW_INDEXING=false

# --- Painel / Analytics ---
# Senha do painel administrativo (/admin/)
PUBLIC_ADMIN_PASSWORD=figaros-admin

# Google Analytics 4 (opcional — deixe vazio para desativar)
# PUBLIC_GA4_ID=G-XXXXXXXXXX